# Copy to .env and adjust. Values below match docker-compose.yml.

# Used by the services running inside Docker Compose
DATABASE_URL=postgresql+asyncpg://booking:booking@postgres:5432/booking
REDIS_URL=redis://redis:6379/0
PAYMENT_URL=http://payment:8001
ADMIN_TOKEN=admin
WORKER_INTERVAL_MS=200

# Used by the test suite running on the host
TEST_DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:55432/booking_test
TEST_REDIS_URL=redis://localhost:56379/15
